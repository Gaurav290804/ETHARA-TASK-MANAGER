{
  "name": "ethara-task-manager-monorepo",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "start:server": "cd server && npm start",
    "start:client": "cd client && npm start"
  }
}
